output$plot <- renderPlot({
wolves %>%
filter(pop==input$x) %>%
ggplot(aes(x = sex,
fill = sex))+
geom_bar(color="black",alpha=0.8)+
labs(x="Sex", y=NULL)
theme_minimal()+
theme_light()
})
}
