gestation %>%
filter(input$x==.data[["order"]]) %>%
ggplot(aes(.data[[input$y]]))+
geom_density(fill="steelblue",
color="black",
alpha=0.6)+
theme_minimal()+
labs(title="Desity Distribution of Varibles by Order",
x="Order",
fill="Order")+
theme_minimal()
})
}
