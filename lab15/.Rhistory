dashboardHeader(title="Population of Types of Wolves?"),
dashboardSidebar(
selectInput("y",
"Select Population",
choices = sort(unique(wolves$pop)),
selected = "BC"),
),
dashboardBody(
plotOutput("plot", width = "600px", height = "500px")
)
)
