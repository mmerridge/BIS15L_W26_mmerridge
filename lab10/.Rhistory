library("tidyverse")
library("janitor")
sharks <-
read_csv("data/SharkIncidents_1950_2022_220302.csv",
na=c("NA", "N/A", "Unknown", "NOT COUNTED", "", " ")) %>%
clean_names()
names(sharks)
sharks %>%
count(county, sort = T) %>%
slice_head(n=5)
sharks %>%
ggplot(mapping = aes(x=county, fill=county))+
geom_bar()+
coord_flip()+
labs(title="Shark Incidents Per County",  x="County", y="Incidents")
sharks %>%
ggplot(mapping = aes(x=month))+ #future maison make month a factor
geom_bar()+
labs(title="Shark Incidents By Month",  x="Month", y="Incidents")
sharks %>%
mutate(across(c("month", "island"), as.factor)) %>%
ggplot(mapping = aes(x=month))+
geom_bar()+
labs(title="Shark Incidents By Month",  x="Month", y="Incidents")
sharks %>%
