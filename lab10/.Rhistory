library(tidyverse)
library(janitor)
library(palmerpenguins)
options(scipen=999) #cancels the use of scientific notation for the session
homerange <- read_csv("data/Tamburelloetal_HomeRangeDatabase.csv", na = c("", "NA", "\\")) %>% clean_names()
p <- homerange %>%
ggplot(aes(x=log10_mass,y=log10_hra))
p+geom_point(size=2.25)
p+geom_point(size=1.25)
p+geom_jutter(size=3)
p+geom_jitter(size=3)
p+geom_point(aes(color=thermoregulation, size=1.5))
p+geom_point(aes(color=thermoregulation), size=1.5)
p+geom_point(aes(color=thermoregulation), size=2)
p+geom_point(aes(shape=thermoregulation, color=thermoregulation), size=2)
p+geom_point(size=3, color="black", alpha=0.8, shape=24, fill="blue")
p+geom_point(size=3, color="black", alpha=0.5, shape=24, fill="blue") #color is outline, fill is inside, alpha is transparency
p+geom_point(size=3, color="black", alpha=0.8, shape=24, fill="blue") #color is outline, fill is inside, alpha is transparency
colors
colors()
# Plot all available point shapes
df <- data.frame(x = 1:25, y = rep(1, 25), shape = 0:24)
ggplot(df, aes(x, y)) +
geom_point(aes(shape = factor(shape)), size = 5, fill = "lightblue") +
scale_shape_manual(values = 0:24) +
theme_void() +
theme(legend.position = "none") +
geom_text(aes(label = shape), vjust = -1, size = 5)
homerange %>%
count(taxon, sort=T)
homerange %>%
ggplot(aes(x=taxon))+
geom_bar()+
coord_flip()+
labs(title="Observations by Taxon",
x="Taxonomic Group")
homerange %>%
ggplot(aes(x=taxon))+
geom_bar()+
coord_flip()+
labs(title="Observations by Taxon",
x="Taxonomic Group",
y=NULL)
homerange %>%
ggplot(aes(x=taxon, fill=trophic_guild))+
geom_bar()+
coord_flip()+
labs(title="Observations by Taxon",
x="Taxonomic Group",
y=NULL) #take away y axis label
homerange %>%
ggplot(aes(x=taxon, fill=trophic_guild))+ #stacked bar plot
geom_bar(position="dodge")+
coord_flip()+
labs(title="Observations by Taxon",
x="Taxonomic Group",
y=NULL) #take away y axis label
homerange %>%
ggplot(aes(x=taxon, fill=trophic_guild))+
geom_bar(position="dodge")+ #side by side bar plot (much better)
labs(title="Observations by Taxon",
x="Taxonomic Group",
y=NULL) #take away y axis label
homerange %>%
ggplot(aes(x=taxon, fill=trophic_guild))+
geom_bar(position="dodge")+ #side by side bar plot (much better)+
theme(axis.text.x=element_text(angle=60, hjust=0.85))+
labs(title="Observations by Taxon",
x="Taxonomic Group",
y=NULL) #take away y axis label
homerange %>%
ggplot(aes(x=taxon, fill=tropic_guild))+
geom_par(position=position_fill())+
scale_y_continuous(labels=scales::percent)
homerange %>%
ggplot(aes(x=taxon, fill=tropic_guild))+
geom_par(position=position_fill())+
scale_y_continuous(labels=scales::percent)+
coord_flip()
homerange %>%
ggplot(aes(x=taxon, fill=tropic_guild))+
geom_bar(position=position_fill())+
scale_y_continuous(labels=scales::percent)+
coord_flip()
homerange %>%
ggplot(aes(x=taxon, fill=tropic_guild))+
geom_bar(position=position_fill())+
scale_y_continuous(labels=scales::percent)+
coord_flip()
homerange %>%
ggplot(aes(x=taxon, fill=trophic_guild))+
geom_bar(position=position_fill())+
scale_y_continuous(labels=scales::percent)+
coord_flip()
homerange %>%
ggplot(aes(x=islands, fill=species))+
geom_bar()+
coord_flip()+
labs(title="Observations by Taxon",
x="Island")
names(homerange)
homerange %>%
ggplot(aes(x=realm, fill=species))+
geom_bar()+
coord_flip()+
labs(title="Observations by Taxon",
x="Island")
homerange %>%
ggplot(aes(x=trophic_guild, fill=species))+
geom_bar()+
coord_flip()+
labs(title="Observations by Taxon",
x="Island")
homerange %>%
ggplot(aes(x=realm, fill=species))+
geom_bar()+
coord_flip()+
labs(title="Observations by Taxon",
x="Island")
names(palmerpenguins)
names(penguins)
penguins %>%
ggplot(aes(x=island, fill=species))+
geom_bar()+
coord_flip()+
labs(title="Observations by Taxon",
x="Island")
penguins %>%
ggplot(aes(x=island, fill=species))+
geom_bar()+
labs(title="Observations by Species",
x="Island")
penguins %>%
ggplot(aes(x=island, fill=species))+
geom_bar(position="dodge")+
labs(title="Observations by Species",x="Island")
penguins %>%
ggplot(aes(x=island, y=sex, fill=sex))+
geom_col(position="dodge")+
labs(title="Observations by Species",x="Island")
penguins %>%
ggplot(aes(x=island, fill=sex))+
geom_bar(position="dodge")+
labs(title="Observations by Species",x="Island")
penguins %>%
ggplot(aes(x=island, fill=sex))+
geom_bar(position="dodge")+
labs(title="Observations by Sex",x="Island")
penguins %>%
na.omit() %>% #gets rid of NAs
ggplot(aes(x=island, fill=sex))+
geom_bar(position="dodge")+
labs(title="Observations by Sex",x="Island")
homerange %>%
ggplot(aes(x=class, y=log10_mass))+
geom_boxplot()
homerange %>%
ggplot(aes(x=class, y=log10_mass, group=taxon))+
geom_boxplot()
homerange %>%
ggplot(aes(x=class, y=log10_mass, fill=taxon))+
geom_boxplot()
