knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(janitor)
sydney <- read_csv("data/sydneybeaches.csv") %>% clean_names()
sydney
View(sydney)
sydneybeaches_long <- sydney %>%
select(site, date, enterococci_cfu_100ml)
sydneybeaches_wide <- sydneybeaches_long %>%
pivot_wider(names_from = date,values_from = enterococci_cfu_100ml)
sydneybeaches_long <- sydneybeaches_wide %>%
pivot_longer(cols = -site,names_to = "date",values_to = "enterococci_cfu_100ml")
sydneybeaches_long <- sydneybeaches_long %>%
separate(date,into = c("day", "month", "year"),sep = "/")
avg_enterococci_by_year <- sydneybeaches_long %>%
group_by(site, year) %>%
summarise(avg_enterococci_cfu_100ml = mean(enterococci_cfu_100ml, na.rm = TRUE))
sydneybeaches_long %>%
group_by(site, year) %>%
summarise(avg_enterococci_cfu_100ml = mean(enterococci_cfu_100ml, na.rm = TRUE))
View(sydneybeaches_wide)
avg_enterococci_by_year_wide <- avg_enterococci_by_year %>%
pivot_wider(names_from = year,values_from = avg_enterococci_cfu_100ml)
avg_enterococci_by_year_wide
sydneybeaches_long %>%
filter(year == 2013) %>%
group_by(site) %>%
summarise(avg_enterococci_cfu_100ml = mean(enterococci_cfu_100ml, na.rm = TRUE)) %>%
arrange(desc(avg_enterococci_cfu_100ml))
sydneybeaches_long %>%
filter(year == 2013) %>%
group_by(site) %>%
summarise(avg_enterococci_cfu_100ml = mean(enterococci_cfu_100ml, na.rm = TRUE)) %>%
arrange(desc(avg_enterococci_cfu_100ml)) %>%
slice_tail(n=1)
knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(janitor)
sydney <- read_csv("data/sydneybeaches.csv") %>% clean_names()
sydneybeaches_long <- sydney %>%
select(site, date, enterococci_cfu_100ml)
sydneybeaches_wide <- sydneybeaches_long %>%
pivot_wider(names_from = date,values_from = enterococci_cfu_100ml)
sydneybeaches_long <- sydneybeaches_wide %>%
pivot_longer(cols = -site,names_to = "date",values_to = "enterococci_cfu_100ml")
sydneybeaches_long <- sydneybeaches_long %>%
separate(date,into = c("day", "month", "year"),sep = "/")
sydneybeaches_long %>%
group_by(site, year) %>%
summarise(avg_enterococci_cfu_100ml = mean(enterococci_cfu_100ml, na.rm = TRUE))
avg_enterococci_by_year_wide <- avg_enterococci_by_year %>%
pivot_wider(names_from = year,values_from = avg_enterococci_cfu_100ml)
avg_enterococci_by_year_wide
sydneybeaches_long %>%
filter(year == 2013) %>%
group_by(site) %>%
summarise(avg_enterococci_cfu_100ml = mean(enterococci_cfu_100ml, na.rm = TRUE)) %>%
arrange(desc(avg_enterococci_cfu_100ml))
sydneybeaches_long %>%
filter(year == 2013) %>%
group_by(site) %>%
summarise(avg_enterococci_cfu_100ml = mean(enterococci_cfu_100ml, na.rm = TRUE)) %>%
arrange(desc(avg_enterococci_cfu_100ml)) %>%
slice_tail(n=1)
