grizzly <- read_csv("data/bear-sightings.csv")%>%
clean_names()
names(grizzly)
grizzly %>%
select(latitude,longitude) %>%
summary()
lat <- c(55.02,70.37)
long <- c(-166.2,-131.3)
bbox <- make_bbox(long,lat,f=0.03)
lat2 <- c(55.02,70.37)
long2 <- c(-166.2,-131.3)
bbox2 <- make_bbox(long,lat,f=0.03)
map2 <- get_stadiamap(bbox2, maptype="stamen_terrain",zoom=8)
map2 <- get_stadiamap(bbox2, maptype="stamen_terrain",zoom=4)
ggmap(map2)
ggmap(map2) +
geom_point(data=grizzly, aes(longitude, latitude), size=1, color="black", alpha=0.8)+
labs(x="Longitude", y="Latitude", title="Alaska Bears")
