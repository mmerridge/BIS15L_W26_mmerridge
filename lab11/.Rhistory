q+scale_color_brewer(palette = "Accent8")
q+scale_color_brewer(palette = "Set3")
q+scale_color_brewer(palette = "Paired12")
q+scale_color_brewer(palette = "Dark2")
q+scale_color_brewer(palette = "Pastel2")
q+scale_color_brewer(palette = "Pastel1")
q+scale_color_brewer(palette = "Set2")
q+scale_color_brewer(palette = "Set1")
q+theme_classic()+
scale_color_brewer(palette = "Accent")
q+theme_classic()+
scale_color_brewer(palette = "Set2")
q+theme_classic()+
scale_color_brewer(palette = "Set1")
