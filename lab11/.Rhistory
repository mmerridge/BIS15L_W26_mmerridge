knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(janitor)
options(scipen = 999)
gapminder <- read_csv("data/gapminder.csv") %>%
clean_names() %>%
filter(between(year, 1925, 2025))
names(gapminder)
glimpse(gapminder)
summary(gapminder)
gapminder %>%
count(country)
gapminder
gapminder %>%
summarise(country)
gapminder %>%
group_by(country)
gapminder %>%
distint(country)
gapminder %>%
distinct(country)
gapminder %>%
mutate(pop_growth=pop(year==2025)-pop(year==1925))
knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(janitor)
options(scipen = 999)
gapminder <- read_csv("data/gapminder.csv") %>%
clean_names() %>%
filter(between(year, 1925, 2025))
names(gapminder)
glimpse(gapminder)
summary(gapminder)
gapminder %>%
distinct(country)
top_5 <- gapminder %>%
filter(year %in% c(1925,2025)) %>%
select(country, year, population) %>%
pivot_wider(names_from = year, values_from = population) %>%
mutate(growth="2025"-"1925") %>%
arrange(desc(growth)) %>%
slice_head(n=5)
top_5 <- gapminder %>%
filter(year %in% c(1925,2025)) %>%
select(country, year, population) %>%
pivot_wider(names_from = year, values_from = population) %>%
mutate(growth="2025"-"1925") %>%
arrange(desc(growth)) %>%
slice_head(n=5)
top_5 <- gapminder %>%
filter(year %in% c(1925,2025)) %>%
select(country, year, pop) %>%
pivot_wider(names_from = year, values_from = pop) %>%
mutate(growth="2025"-"1925") %>%
arrange(desc(growth)) %>%
slice_head(n=5)
top_5 <- gapminder %>%
filter(year %in% c(1925,2025)) %>%
select(country, year, pop) %>%
pivot_wider(names_from = year, values_from = pop) %>%
mutate(growth=2025-1925) %>%
arrange(desc(growth)) %>%
slice_head(n=5)
top_5
top_5 <- gapminder %>%
filter(year %in% c(1925,2025)) %>%
select(country, year, pop) %>%
pivot_wider(names_from = year, values_from = pop) %>%
mutate(growth='2025'-'1925') %>%
arrange(desc(growth)) %>%
slice_head(n=5)
top_5 <- gapminder %>%
filter(year %in% c(1925,2025)) %>%
select(country, year, pop) %>%
pivot_wider(names_from = year, values_from = pop) %>%
mutate(growth=`2025`-`1925`) %>%
arrange(desc(growth)) %>%
slice_head(n=5)
top_5
gapminder %>%
filter(country == "India") %>%
ggplot(aes(x = year, y = pop)) +
geom_line(color = "blue") +
labs(title = "Population Growth Over Time - India",
x = "Year",
y = "Population")
life_expectancy <- gapminder %>%
filter(year %in% c(1925, 2025)) %>%
group_by(year) %>%
summarise(
min_lex = min(lex, na.rm = TRUE),
median_lex = median(lex, na.rm = TRUE),
mean_lex = mean(lex, na.rm = TRUE),
max_lex = max(lex, na.rm = TRUE))
life_expectancy
life_expectancy %>%
filter(year %in% c(1925, 2025)) %>%
ggplot(aes(x = lifeExp, fill = factor(year))) +
geom_density(alpha = 0.5) +
labs(title = "Distribution of Life Expectancy: 1925 vs 2025",
x = "Life Expectancy",
y = "Density",
fill = "Year") +
theme_minimal()
life_expectancy %>%
filter(year %in% c(1925, 2025)) %>%
ggplot(aes(x = lex, fill = factor(year))) +
geom_density(alpha = 0.5) +
labs(title = "Distribution of Life Expectancy: 1925 vs 2025",
x = "Life Expectancy",
y = "Density",
fill = "Year") +
theme_minimal()
life_expectancy %>%
filter(year %in% c(1925, 2025)) %>%
select(lex, year)
life_expectancy %>%
filter(year %in% c(1925, 2025)) %>%
ggplot(aes(x = lex, fill = factor(year))) +
geom_density(alpha = 0.5) +
labs(title = "Distribution of Life Expectancy: 1925 vs 2025",
x = "Life Expectancy",
y = "Density",
fill = "Year") +
theme_minimal()
gapminder %>%
filter(year %in% c(1925, 2025)) %>%
ggplot(aes(x = lex, fill = factor(year))) +
geom_density(alpha = 0.5) +
labs(title = "Life Expectancy: 1925 vs 2025",
x = "Life Expectancy",
y = "Density",
fill = "Year") +
theme_classic()
gapminder %>%
filter(year == 2025, country != "Monaco") %>%
ggplot(aes(x = gdp, y = lex)) +
geom_point(color = "blue") +
geom_smooth(method = "lm", se = FALSE, color = "red") +
labs(title = "Relationship Between GDP and Life Expectancy",
x = "GDP",
y = "Life Expectancy") +
theme_classic()
gdp_growth <- gapminder %>%
filter(year %in% c(1975, 2025), country != "Monaco") %>%
select(country, year, gdp) %>%
pivot_wider(names_from = year, values_from = gdp) %>%
mutate(gdp_growth = `2025` - `1975`) %>%
arrange(desc(gdp_growth)) %>%
slice_head(n = 5)
gdp_growth
five_countries <- gdp_growth$country
gapminder %>%
filter(country %in% five_countries, year >= 1975) %>%
ggplot(aes(x = year, y = gdp, color = country)) +
geom_line(size = 1.2) +
geom_point(size = 2) +
labs(title = "GDP per Capita Growth Over the Past 50 Years",
x = "Year",
y = "GDP per Capita",
color = "Country") +
theme_classic()
top5_pop <- gapminder %>%
filter(year == 2025) %>%
arrange(desc(pop)) %>%
slice_head(n = 5) %>%
select(country, pop, lex, gdp)
top5_pop
gapminder %>%
filter(year == 2025) %>%
ggplot(aes(x = pop, y = lex)) +
geom_point(color = "darkgreen", alpha = 0.7) +
geom_smooth(method = "lm", se = FALSE, color = "red") +
scale_x_continuous(labels = scales::comma) +
labs(title = "Life Expectancy vs Population Size (2025)",
x = "Population",
y = "Life Expectancy") +
theme_classic()
gapminder %>%
filter(year == 2025) %>%
ggplot(aes(x = pop, y = lex)) +
