library("tidyverse")
library("janitor")
#library("naniar")
options(scipen = 999)
fisheries_clean <- read_csv("data/fisheries_clean.csv")
names(fisheries_clean)
glimpse(fisheries_clean)
structure(fisheries_clean)
fish_factors <- fisheries_clean %>%
mutate(across(c("period", "continent", "geo_region","country","scientific_name","common_name","taxonomic_code","status"), as.factor))
fish_factors %>%
count(country)
names(fish_factors)
fish_factors %>%
summarize(n_species_common_name=n_distinct(common_name))
fish_factors %>%
summarize(n_species_taxonomic_code=n_distinct(taxonomic_code))
names(fish_factors)
fish_factors %>%
filter(period==2023) %>%
group_by(country) %>%
summarize(total_catch=sum(catch, na.rm=T)) %>%
arrange(desc(total_catch)) %>%
slice_head(n=5)
fish_factors %>%
filter(period==2023) %>%
group_by(common_name) %>%
summarize(total_catch=sum(catch, na.rm=T)) %>%
arrange(desc(total_catch)) %>%
slice_head(n=10)
fish_factors %>%
filter(period==2023,common_name=="Alaska pollock(=Walleye poll.)") %>%
group_by(country) %>%
summarize(total_catch=sum(catch, na.rm=T)) %>%
arrange(desc(total_catch)) %>%
slice_head(n=1)
fish_factors %>%
filter(common_name=="Alaska pollock(=Walleye poll.)") %>%
summarize(total_catch=sum(catch, na.rm=T)) %>%
ggplot(mapping=aes(x=period,y=total_catch))+
geom_point(mapping=aes(color=common_name))+
geom_smooth(method=lm,se=T)+
labs(title="Title",x="x axis",y="y axis")
