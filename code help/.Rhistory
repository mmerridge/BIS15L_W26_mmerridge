library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
register_stadiamaps("4330f9a3-4680-4f85-b512-355305c94913", write = FALSE)
polar_bears <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class==c("A", "S")) %>%
mutate(sex=toupper(sex),
age_class=toupper(age_class))
names(polar_bears)
summary(polar_bears)
polar_bears %>%
replace_with_na_all(condition = ~ .x == -999)
polar_bears %>%
replace_with_na_all(condition = ~ .x %in% c(common_na_numbers, common_na_strings, "unknown"))
polar_bears %>%
ggplot(aes(x = popn, fill = sex)) +
geom_bar(position = "dodge") +
labs(title = "Sampling of Populations by Sex",
x     = "Population",
y     = NULL)
polar_bears <- polar_bears %>%
separate(capture_date,
into = c("year_captured", "month_captured", "day_captured"),
sep  = "-")
polar_bears %>%
count()
polar_bears %>%
ggplot(aes(x=year_captured, color=sex, fill=sex))+
coord_flip() +
geom_density(alpha=0.5)+
labs(title="Years Polar Bears Were Sampled",
x="Sampled Polar Bears", y=NULL,
color="Year",
fill="Year")
polar_bears %>%
summarize(mean_urea = mean(urea_nitrogen),
min_urea  = min(urea_nitrogen),
med_urea = median(urea_nitrogen),
max_urea  = max(urea_nitrogen))
polar_bears %>%
summarize(mean_cre = mean(creatinine),
min_cre  = min(creatinine),
med_cre = median(creatinine),
max_cre  = max(creatinine))
polar_bears <- polar_bears %>%
mutate(un_creat_ratio = urea_nitrogen * 0.466 / creatinine) %>%
select(creatinine, urea_nitrogen, un_creat_ratio)
polar_bears <- polar_bears%>%
mutate(fasting = case_when(
un_creat_ratio <= 10  ~"fasting"))
polar_bears %>%
ggplot(aes(x=, y = fasting, fill= population))+
coord_flip() +
geom_density(alpha=0.5)+
labs(title="Years Polar Bears Were Sampled",
x="Sampled Polar Bears", y=NULL,
color=population,
fill=population)
polar_bears %>%
ggplot(aes(x= year_captured, y = fasting, fill= population))+
coord_flip() +
geom_density(alpha=0.5)+
labs(title="Years Polar Bears Were Sampled",
x="Sampled Polar Bears", y=NULL,
color=population,
fill=population)
