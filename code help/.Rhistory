library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
register_stadiamaps("4330f9a3-4680-4f85-b512-355305c94913", write = FALSE)
polar_bears <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class==c("A", "S")) %>%
mutate(sex=toupper(sex),
age_class=toupper(age_class))
names(polar_bears)
polar_bears %>%
select(lat, long) %>%
summary()
lat  <- c(62.46, 72.70)
long <- c(-172.2, -134.8)
bbox <- make_bbox(long, lat, f = 0.03)
bear_map <- get_stadiamap(bbox, maptype = "stamen_terrain", zoom = 7)
bear_map <- get_stadiamap(bbox, maptype = "stamen_terrain", zoom = 5)
ggmap(bear_map) +
geom_point(data  = polar_bears,
aes(long, lat),
size  = 1,
color = "red",
alpha = 0.8) +
labs(x     = "Longitude",
y     = "Latitude",
title = "Location of Polar Bears")
ui <- dashboardPage(
dashboardHeader(title = "Ranges of Creatine Ratio"),
dashboardSidebar(disable = T),
dashboardBody(
selectInput("y",
"Select Variable",
choices  = c("sex", "mating", "age_class", "denning", "fasting"),
selected = "sex"),
plotOutput("plot", width = "500px", height = "400px")
)
)
library(shiny)
ui <- fluidPage(
selectInput("y",
"Select Variable",
choices  = c("sex", "mating", "age_class", "denning", "fasting"),
selected = "sex"),
plotOutput("plot", width = "500px", height = "400px")
)
)
library(shiny)
ui <- fluidPage(
selectInput("y",
"Select Variable",
choices  = c("sex", "mating", "age_class", "denning", "fasting"),
selected = "sex"),
plotOutput("plot", width = "500px", height = "400px")
)
server <- function(input, output, session) {
output$plot <- renderPlot({
polar_bears %>%
filter(!is.na(un_creat_ratio)) %>%
ggplot(aes(x    = un_creat_ratio,
y    = .data[[input$y]],
fill = sex)) +
geom_boxplot(alpha = 0.8, color = "black") +
labs(title = paste("Range of un_creat_ratio by", input$y),
x     = "un_creat_ratio",
y     = input$y) +
theme_minimal()
})
}
shinyApp(ui, server)
