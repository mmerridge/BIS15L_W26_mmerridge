library(tidyverse)
library(janitor)
anolis <- read_csv("data/anolis_dat.csv") %>% clean_names()
summary(anolis)
names(anolis)
glimpse(anolis)
anolis_factors <- anolis %>%
mutate(across(c("habitat", "island"), as.factor))
anolis_factors %>%
select(island) %>%
distinct()
names(anolis)
ggplot(data=anolis_factors,
mapping=aes(x=island))+
geom_bar(mapping = aes())+
labs(title = "Animal Groups Represented By Data")
ggplot(data=anolis_factors,
mapping=aes(x=island))+
geom_bar(mapping = aes())+
labs(title = "Number of Anole Species Sampled From Each Island",
x=island, y=count of anole species)
ggplot(data=anolis_factors,
mapping=aes(x=island))+
geom_bar(mapping = aes())+
labs(title = "Number of Anole Species Sampled From Each Island", x=island, y=count of anole species)
ggplot(data=anolis_factors,
mapping=aes(x=island))+
geom_bar(mapping = aes())+
labs(title = "Number of Anole Species Sampled From Each Island", x="island", y="count of anole species")
names(anolis)
anolis_factors %>%
select(species) %>%
distinct()
anolis_factors %>%
select(habtat) %>%
distinct()
anolis_factors %>%
select(habitat) %>%
distinct()
ggplot(data=anolis_factors,
mapping=aes(x=habitat))+
geom_bar(mapping = aes())+
labs(title = "Number of Anole Species Sampled From Each Habitat", x="habitat type", y="count of anole species")
names(anolis)
ggplot(data=anolis_factors,
mapping=aes(x=habitat, y=hindlimb_length_mm))+
geom_boxplot(mapping = aes())+
labs(title = "Number of Anole Species Sampled From Each Habitat", x="habitat type", y="count of anole species")
ggplot(data=anolis_factors,
mapping=aes(x=habitat, y=hindlimb_length_mm))+
geom_boxplot(mapping = aes())+
labs(title = "Rangle of Hindlimb Length Across Habitats", x="habitat type", y="hindlimb lenth (mm)")
ggplot(data=anolis_factors,
mapping=aes(x=habitat, y=hindlimb_length_mm))+
geom_boxplot(mapping = aes())+
labs(title = "Range of Hindlimb Length Across Habitats", x="habitat type", y="hindlimb lenth (mm)")
names(anolis)
anolis_factors %>%
mutate(ratio_of_hindlimb_to_body=hindlimb_length_mm/body_length_mm,
ratio_of_tail_to_body=tail_length_mm/body_length_mm)
names(anolis_factors)
anolis_factors %>%
mutate(ratio_of_hindlimb_to_body=hindlimb_length_mm/body_length_mm,
ratio_of_tail_to_body=tail_length_mm/body_length_mm) %>%
ggplot(mapping=aes(x=habitat, y=ratio_of_hindlimb_to_body))+
geom_boxplot(mapping=aes())+
labs(title = "Range of Hindlimb Length Across Habitats", x="habitat type", y="hindlimb lenth (mm)")
anolis_factors %>%
mutate(ratio_of_hindlimb_to_body=hindlimb_length_mm/body_length_mm,
ratio_of_tail_to_body=tail_length_mm/body_length_mm) %>%
ggplot(mapping=aes(x=habitat, y=ratio_of_hindlimb_to_body))+
geom_boxplot(mapping=aes())+
labs(title = "Range of Ratio of Hindlimb to Body Across Habitats", x="habitat type", y="ratio of hindlimb to body")
ggplot(data=anolis_factors,
mapping=aes(x=habitat, y=hindlimb_length_mm))+
geom_boxplot(mapping = aes())+
labs(title = "Range of Hindlimb Length Across Habitats", x="habitat type", y="hindlimb lenth (mm)")
names(anolis)
ggplot(data=anolis_factors,
mapping=aes(x=body_length_mm, y=tail_length_mm, color=habitat))+
geom_point(na.rm=T)+
geom_smooth(method=lm,se=T)
ggplot(data=anolis_factors,
mapping=aes(x=body_length_mm, y=tail_length_mm))+
geom_point(mapping=aes(color=habitat,na.rm=T))+
geom_smooth(method=lm,se=T)+
labs(title-"xxxxx",x="xxx",y="xxxx")
ggplot(data=anolis_factors,
mapping=aes(x=body_length_mm, y=tail_length_mm))+
geom_point(mapping=aes(color=habitat))+
geom_smooth(method=lm,se=T)+
labs(title-"xxxxx",x="xxx",y="xxxx")
ggplot(data=anolis_factors,
mapping=aes(x=body_length_mm, y=tail_length_mm))+
geom_point(mapping=aes(color=habitat))+
geom_smooth(method=lm,se=T)+
labs(title-"Body",x="Body",y="Body")
ggplot(data=anolis_factors,
mapping=aes(x=body_length_mm, y=tail_length_mm))+
geom_point(mapping=aes(color=habitat))+
geom_smooth(method=lm,se=T)+
labs(title="Body",x="Body",y="Body")
ggplot(data=anolis_factors,
mapping=aes(x=body_length_mm, y=tail_length_mm))+
geom_point(mapping=aes(color=habitat))+
geom_smooth(method=lm,se=T)+
labs(title="Body Length vs Tail Length Across Habitats",x="Body Length",y="Tail Length")
names(anolis)
anolis_factors %>%
filter(habitat=="Grass-bush") %>%
summarize(mean_toepad_lamellae_count=mean(toepad_lamellae_count, na.rm=T))
anolis_factors %>%
filter(habitat=="Trunk-crown") %>%
summarize(mean_toepad_lamellae_count=mean(toepad_lamellae_count, na.rm=T))
anolis_factors %>%
filter(habitat=="Trunk-ground") %>%
summarize(mean_toepad_lamellae_count=mean(toepad_lamellae_count, na.rm=T))
anolis_factors %>%
filter(habitat=="Twig") %>%
summarize(mean_toepad_lamellae_count=mean(toepad_lamellae_count, na.rm=T))
names(anolis)
anolis_factors %>%
filter(habitat="Trunk-crown") %>%
mutate(mean_toepad_lamellae_count=mean(toepad_lamellae_count, na.rm=T))
anolis_factors %>%
filter(habitat=="Trunk-crown") %>%
mutate(mean_toepad_lamellae_count=mean(toepad_lamellae_count, na.rm=T))
anolis_factors %>%
filter(habitat=="Trunk-crown") %>%
ggplot(mapping=aes(x=habitat, y=ratio_of_hindlimb_to_body))+
geom_boxplot(mapping=aes())+
labs(title = "Range of Ratio of Hindlimb to Body Across Habitats", x="habitat type", y="ratio of hindlimb to body")
anolis_factors %>%
filter(habitat=="Trunk-crown") %>%
ggplot(mapping=aes(x=island, y=toepad_lamellae_count))+
geom_boxplot(mapping=aes())+
labs(title = "Range of Ratio of Hindlimb to Body Across Habitats", x="habitat type", y="ratio of hindlimb to body")
anolis_factors %>%
filter(habitat=="Trunk-crown") %>%
ggplot(mapping=aes(x=island, y=toepad_lamellae_count))+
geom_boxplot(mapping=aes())+
labs(title = "Range of Toepad Lamellae on Trunk-Crown Species Across Islands", x="Island", y="Count of Toepad Lamellae")
